{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "habitae-waitlist",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-06",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "SITE_ORIGIN": "https://habitae.pt",
    "RESEND_FROM": "Habitae <hello@example.com>",
    "RESEND_REPLY_TO": "support@example.com",
    "WAITLIST_ADMIN_TO": "admin@example.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "habitae-waitlist",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": [
      "0 3 * * *",
      "*/5 * * * *"
    ]
  }
}
