{
  "name": "habitae-web",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "description": "Habitae public marketing website",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test scripts/i18n.test.mjs scripts/site.test.mjs scripts/waitlist.test.mjs scripts/waitlist-email.test.mjs scripts/consent.test.mjs scripts/agent-edge.test.mjs",
    "test:build": "node --test scripts/build.test.mjs",
    "test:browser": "playwright test",
    "audit:lighthouse": "node scripts/audit.mjs",
    "edge:dev": "wrangler dev --config services/agent-edge/wrangler.jsonc --local",
    "edge:check": "wrangler deploy --config services/agent-edge/wrangler.jsonc --dry-run",
    "edge:deploy": "wrangler deploy --config services/agent-edge/wrangler.jsonc",
    "verify:agents": "node scripts/verify-agent-endpoints.mjs",
    "test:edge": "HABITAE_TEST_EDGE=true playwright test",
    "test:edge:http": "node scripts/check-agent-edge.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "lucide-react": "^0.552.0",
    "negotiator": "1.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "lighthouse": "13.4.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "wrangler": "^4.129.0"
  }
}
